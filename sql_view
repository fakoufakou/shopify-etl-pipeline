# Vue automatique pour toujours utiliser la dernière table.
# Table clients

DO $$
DECLARE
    last_table text;
BEGIN
    # Récupère la dernière table clients.
    SELECT table_name INTO last_table
    FROM information_schema.tables
    WHERE table_name LIKE 'clients_%'
    ORDER BY table_name DESC
    LIMIT 1;

    #Information affichee

    RAISE NOTICE 'Vue clients créée avec : %', last_table;

    # Création de la vue.
    EXECUTE format('
        CREATE OR REPLACE VIEW vue_clients_clean AS
        SELECT
            customer_id,
            first_name,
            last_name,
            email,
            accepts_email_marketing,
            default_address_company,
            default_address_address1,
            default_address_city,
            default_address_zip,
            tags
        FROM %I;
    ', last_table);
END $$;


